<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Big Brothers Corniks | Proudly Made in Isabela</title>

  <meta
    name="description"
    content="Big Brothers Corniks by 3 Sher's Food Products. Proudly made in Cauayan City, Isabela since 1989. Explore Classic Cheese, Spicy, and Garlic with Chips."
  >

  <style>
    :root{
      --cream:#FFF1D6;
      --yellow:#FFC928;
      --red:#C7361F;
      --green:#2F6B3F;
      --orange:#F26B2D;
      --brown:#3A2418;
      --blue:#1859A8;
      --white:#FFFFFF;
      --black:#191919;
      --muted:#735F50;
      --radius:28px;
      --shadow:0 18px 55px rgba(58,36,24,.13);
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      color:var(--brown);
      background:#fffaf1;
      line-height:1.6;
      overflow-x:hidden;
    }

    img{
      max-width:100%;
      display:block;
    }

    a{
      color:inherit;
      text-decoration:none;
    }

    button,
    input,
    select,
    textarea{
      font:inherit;
    }

    .container{
      width:min(1180px, calc(100% - 40px));
      margin:auto;
    }

    .announcement{
      background:var(--brown);
      color:white;
      text-align:center;
      padding:9px 15px;
      font-size:.88rem;
      font-weight:800;
      letter-spacing:.04em;
    }

    header{
      position:sticky;
      top:0;
      z-index:1000;
      background:rgba(255,250,241,.93);
      backdrop-filter:blur(18px);
      border-bottom:1px solid rgba(58,36,24,.09);
    }

    .nav{
      min-height:82px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:30px;
    }

    .logo{
      width:180px;
      max-height:65px;
      object-fit:contain;
    }

    nav{
      display:flex;
      align-items:center;
      gap:22px;
      font-size:.91rem;
      font-weight:700;
    }

    nav a:hover{
      color:var(--red);
    }

    .btn{
      display:inline-flex;
      justify-content:center;
      align-items:center;
      gap:8px;
      border:0;
      border-radius:999px;
      padding:14px 22px;
      font-weight:800;
      cursor:pointer;
      transition:.25s ease;
    }

    .btn:hover{
      transform:translateY(-3px);
    }

    .btn-primary{
      background:var(--yellow);
      color:var(--brown);
      box-shadow:0 10px 25px rgba(255,201,40,.3);
    }

    .btn-dark{
      background:var(--brown);
      color:white;
    }

    .btn-outline{
      border:2px solid currentColor;
      background:transparent;
      color:white;
    }

    .mobile-menu{
      display:none;
      font-size:1.7rem;
      border:0;
      background:transparent;
      cursor:pointer;
    }

    /* HERO */

    .hero{
      position:relative;
      min-height:82vh;
      display:flex;
      align-items:center;
      overflow:hidden;

      background:
        radial-gradient(
          circle at 80% 30%,
          rgba(255,201,40,.45),
          transparent 30%
        ),
        linear-gradient(
          130deg,
          #3a2418 0%,
          #7b371e 45%,
          #d86c29 100%
        );

      color:white;
    }

    .hero:before{
      content:"";
      position:absolute;
      inset:0;

      background:
        linear-gradient(
          90deg,
          rgba(36,19,10,.76),
          rgba(36,19,10,.28)
        ),
        url("assets/550g-flavors-group.jpg") center/cover no-repeat;

      opacity:.78;
    }

    .hero-content{
      position:relative;
      z-index:2;
      padding:110px 0;
      max-width:720px;
    }

    .eyebrow{
      display:inline-flex;
      background:rgba(255,255,255,.14);
      border:1px solid rgba(255,255,255,.25);
      border-radius:999px;
      padding:8px 14px;
      margin-bottom:20px;
      font-size:.78rem;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.12em;
    }

    h1{
      font-size:clamp(3rem,7vw,6.6rem);
      line-height:.91;
      letter-spacing:-.065em;
      max-width:800px;
    }

    .hero p{
      max-width:620px;
      font-size:1.14rem;
      margin:25px 0 32px;
      color:#fff7e8;
    }

    .hero-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
    }

    .scroll-text{
      position:absolute;
      right:28px;
      bottom:25px;
      z-index:2;
      font-size:.76rem;
      font-weight:800;
      letter-spacing:.12em;
      text-transform:uppercase;
      writing-mode:vertical-rl;
      opacity:.75;
    }

    section{
      padding:100px 0;
    }

    .section-head{
      max-width:700px;
      margin-bottom:46px;
    }

    .section-label{
      color:var(--red);
      text-transform:uppercase;
      letter-spacing:.14em;
      font-size:.76rem;
      font-weight:900;
      margin-bottom:12px;
    }

    h2{
      font-size:clamp(2.3rem,5vw,4.5rem);
      letter-spacing:-.055em;
      line-height:1;
      margin-bottom:18px;
    }

    .section-head p{
      font-size:1.08rem;
      color:var(--muted);
    }

    /* FLAVORS */

    .flavors{
      background:var(--cream);
    }

    .flavor-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:22px;
    }

    .flavor-card{
      min-height:550px;
      border-radius:var(--radius);
      padding:30px;
      display:flex;
      flex-direction:column;
      overflow:hidden;
      position:relative;
      transition:.35s ease;
      box-shadow:var(--shadow);
    }

    .flavor-card:hover{
      transform:translateY(-10px) scale(1.015);
    }

    .flavor-card.yellow{
      background:linear-gradient(160deg,#ffe879,#ffc928);
    }

    .flavor-card.red{
      background:linear-gradient(160deg,#ec644d,#a91d13);
      color:white;
    }

    .flavor-card.green{
      background:linear-gradient(160deg,#61a874,#225533);
      color:white;
    }

    .flavor-card img{
      width:100%;
      height:315px;
      object-fit:contain;
      filter:drop-shadow(0 18px 18px rgba(0,0,0,.15));
      margin-bottom:18px;
      transition:.3s ease;
    }

    .flavor-card:hover img{
      transform:scale(1.05) rotate(-1deg);
    }

    .flavor-card h3{
      font-size:2rem;
      letter-spacing:-.04em;
    }

    .flavor-card p{
      margin:8px 0 18px;
      opacity:.88;
    }

    .sizes{
      font-weight:800;
      font-size:.86rem;
    }

    /* SIZE CARDS */

    .size-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .size-card{
      border:1px solid rgba(58,36,24,.12);
      background:white;
      padding:40px;
      border-radius:24px;
      box-shadow:0 8px 25px rgba(58,36,24,.06);
    }

    .size-card .number{
      font-size:3.5rem;
      font-weight:900;
      color:var(--orange);
      letter-spacing:-.06em;
    }

    .size-card h3{
      font-size:1.3rem;
      margin:8px 0;
    }

    /* COMPARISON */

    .comparison{
      background:var(--brown);
      color:white;
    }

    .comparison .section-label{
      color:var(--yellow);
    }

    .comparison .section-head p{
      color:#e8daca;
    }

    .table-wrap{
      overflow:auto;
      border-radius:20px;
      border:1px solid rgba(255,255,255,.13);
    }

    table{
      border-collapse:collapse;
      width:100%;
      min-width:760px;
    }

    th,
    td{
      padding:20px 22px;
      text-align:left;
      border-bottom:1px solid rgba(255,255,255,.11);
    }

    th{
      color:var(--yellow);
      font-size:.78rem;
      text-transform:uppercase;
      letter-spacing:.09em;
    }

    /* NUTRITION */

    .nutrition{
      background:#fff;
    }

    .nutrition-box{
      display:grid;
      grid-template-columns:.7fr 1.3fr;
      gap:35px;
      background:#fff8ea;
      padding:35px;
      border-radius:30px;
    }

    .selector label{
      display:block;
      font-weight:900;
      margin:0 0 8px;
    }

    .selector select{
      width:100%;
      padding:14px 15px;
      border:1px solid #d7c6b5;
      border-radius:12px;
      background:white;
      margin-bottom:20px;
    }

    .nutrition-panel{
      background:white;
      border:4px solid var(--black);
      padding:20px;
      color:#111;
      max-width:550px;
    }

    .nutrition-panel h3{
      font-size:2.3rem;
      border-bottom:8px solid #111;
      line-height:1;
      padding-bottom:10px;
    }

    .nutrition-row{
      display:flex;
      justify-content:space-between;
      gap:15px;
      padding:7px 0;
      border-bottom:1px solid #111;
      font-size:.9rem;
    }

    .nutrition-note{
      margin-top:18px;
      font-size:.85rem;
      color:var(--muted);
    }

    /* STORY */

    .story{
      background:var(--cream);
    }

    .story-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:60px;
      align-items:center;
    }

    .story-image{
      border-radius:30px;
      min-height:540px;
      height:540px;
      width:100%;
      object-fit:cover;
      box-shadow:var(--shadow);
    }

    .story-copy p{
      margin-bottom:18px;
      font-size:1.05rem;
      color:var(--muted);
    }

    .heritage-number{
      font-size:5rem;
      color:var(--orange);
      font-weight:900;
      letter-spacing:-.07em;
      line-height:1;
      margin:18px 0 6px;
    }

    /* PROCESS */

    .process-grid{
      display:grid;
      grid-template-columns:repeat(6,1fr);
      gap:13px;
    }

    .process-step{
      padding:24px 16px;
      background:white;
      border-radius:20px;
      border:1px solid rgba(58,36,24,.1);
      text-align:center;
    }

    .process-step span{
      width:40px;
      height:40px;
      border-radius:50%;
      display:inline-grid;
      place-items:center;
      background:var(--yellow);
      font-weight:900;
      margin-bottom:13px;
    }

    .process-step h3{
      font-size:.98rem;
    }

    /* QUALITY */

    .quality{
      background:#f8eee0;
    }

    .quality-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:16px;
    }

    .quality-card{
      background:white;
      padding:28px;
      border-radius:20px;
      min-height:160px;
    }

    .quality-icon{
      font-size:2rem;
      margin-bottom:14px;
    }

    /* BUY */

    .buy{
      background:linear-gradient(135deg,var(--blue),#123a74);
      color:white;
    }

    .buy .section-label{
      color:var(--yellow);
    }

    .buy .section-head p{
      color:#dfeeff;
    }

    .buy-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .buy-card{
      background:white;
      color:var(--brown);
      border-radius:24px;
      padding:32px;
      display:flex;
      flex-direction:column;
      gap:13px;
    }

    .buy-card h3{
      font-size:1.7rem;
    }

    /* CONTACT */

    .contact-grid{
      display:grid;
      grid-template-columns:.8fr 1.2fr;
      gap:50px;
    }

    .contact-details p{
      margin:12px 0;
    }

    .contact-form{
      display:grid;
      gap:14px;
    }

    .contact-form input,
    .contact-form select,
    .contact-form textarea{
      width:100%;
      padding:15px;
      border:1px solid #d5c4b1;
      border-radius:12px;
      background:white;
    }

    .contact-form textarea{
      min-height:150px;
      resize:vertical;
    }

    /* FOOTER */

    footer{
      background:#21150f;
      color:#e9d9c8;
      padding:65px 0 25px;
    }

    .footer-grid{
      display:grid;
      grid-template-columns:2fr 1fr 1fr;
      gap:40px;
      padding-bottom:50px;
    }

    footer h4{
      color:white;
      margin-bottom:14px;
    }

    footer a{
      display:block;
      margin:8px 0;
      color:#e9d9c8;
    }

    .footer-bottom{
      border-top:1px solid rgba(255,255,255,.12);
      padding-top:22px;
      font-size:.86rem;
    }

    /* ANIMATION */

    .reveal{
      opacity:0;
      transform:translateY(30px);
      transition:.7s ease;
    }

    .reveal.visible{
      opacity:1;
      transform:none;
    }

    /* TABLET */

    @media(max-width:950px){

      nav{
        display:none;
        position:absolute;
        top:82px;
        left:0;
        right:0;
        background:#fffaf1;
        padding:25px;
        flex-direction:column;
        box-shadow:0 20px 40px rgba(0,0,0,.12);
      }

      nav.open{
        display:flex;
      }

      .mobile-menu{
        display:block;
      }

      .desktop-buy{
        display:none;
      }

      .flavor-grid,
      .size-grid,
      .buy-grid{
        grid-template-columns:1fr;
      }

      .story-grid,
      .nutrition-box,
      .contact-grid{
        grid-template-columns:1fr;
      }

      .process-grid{
        grid-template-columns:repeat(3,1fr);
      }

      .quality-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .story-image{
        min-height:420px;
        height:420px;
      }
    }

    /* MOBILE */

    @media(max-width:600px){

      section{
        padding:75px 0;
      }

      .container{
        width:min(100% - 26px,1180px);
      }

      .logo{
        width:145px;
      }

      .hero{
        min-height:78vh;
      }

      .hero-content{
        padding:80px 0;
      }

      h1{
        font-size:3.35rem;
      }

      .process-grid,
      .quality-grid{
        grid-template-columns:1fr;
      }

      .footer-grid{
        grid-template-columns:1fr;
      }

      .flavor-card{
        min-height:auto;
      }

      .flavor-card img{
        height:280px;
      }

      .story-image{
        min-height:340px;
        height:340px;
      }

      .nutrition-box{
        padding:22px;
      }

      .scroll-text{
        display:none;
      }
    }

  </style>
</head>

<body>

  <!-- ANNOUNCEMENT -->

  <div class="announcement">
    Proudly made in Cauayan City, Isabela since 1989
  </div>

  <!-- HEADER -->

  <header>
    <div class="container nav">

      <a href="#top">
        <img
          src="assets/logo.png"
          class="logo"
          alt="Big Brothers Corniks"
        >
      </a>

      <nav id="navigation">
        <a href="#flavors">Flavors</a>
        <a href="#sizes">Sizes</a>
        <a href="#nutrition">Nutrition</a>
        <a href="#story">Our Story</a>
        <a href="#quality">Quality</a>
        <a href="#buy">Where to Buy</a>
        <a href="#contact">Contact</a>
      </nav>

      <a
        href="#buy"
        class="btn btn-primary desktop-buy"
      >
        Where to Buy
      </a>

      <button
        class="mobile-menu"
        type="button"
        aria-label="Open navigation menu"
        onclick="document.getElementById('navigation').classList.toggle('open')"
      >
        ☰
      </button>

    </div>
  </header>

  <main id="top">

    <!-- HERO -->

    <section class="hero">

      <div class="container">

        <div class="hero-content">

          <div class="eyebrow">
            Real Corn • Real Crunch
          </div>

          <h1>
            Crunch made proudly in Isabela.
          </h1>

          <p>
            Big Brothers Corniks brings bold Filipino flavor in every crispy bite.
            Choose Classic Cheese, Spicy, or Garlic with Chips — made for merienda,
            pasalubong, gatherings, and everyday snacking.
          </p>

          <div class="hero-actions">

            <a
              href="#flavors"
              class="btn btn-primary"
            >
              Explore Flavors
            </a>

            <a
              href="#buy"
              class="btn btn-outline"
            >
              Where to Buy
            </a>

          </div>

        </div>

      </div>

      <div class="scroll-text">
        Scroll for the crunch
      </div>

    </section>

    <!-- FLAVORS -->

    <section
      class="flavors"
      id="flavors"
    >

      <div class="container">

        <div class="section-head reveal">

          <div class="section-label">
            Pick your favorite
          </div>

          <h2>
            Three Signature Flavors
          </h2>

          <p>
            Three flavors. Three sizes. One satisfying crunch.
          </p>

        </div>

        <div class="flavor-grid">

          <!-- CHEESE -->

          <article class="flavor-card yellow reveal">

            <img
              src="assets/cheese-550g.jpg"
              alt="Classic Cheese Big Brothers Corniks 550g"
            >

            <h3>
              Classic Cheese
            </h3>

            <p>
              A cheesy favorite made for family snacking and sharing.
            </p>

            <div class="sizes">
              23 g • 90 g • 550 g
            </div>

          </article>

          <!-- SPICY -->

          <article class="flavor-card red reveal">

            <img
              src="assets/spicy-550g.jpg"
              alt="Spicy Big Brothers Corniks 550g"
            >

            <h3>
              Spicy
            </h3>

            <p>
              A bold, savory crunch with a spicy kick for snackers who love heat.
            </p>

            <div class="sizes">
              23 g • 90 g • 550 g
            </div>

          </article>

          <!-- GARLIC -->

          <article class="flavor-card green reveal">

            <img
              src="assets/garlic-550g.jpg"
              alt="Garlic with Chips Big Brothers Corniks 550g"
            >

            <h3>
              Garlic with Chips
            </h3>

            <p>
              Garlicky, savory crunch with extra chip-style texture.
            </p>

            <div class="sizes">
              23 g • 90 g • 550 g
            </div>

          </article>

        </div>

      </div>

    </section>

    <!-- SIZES -->

    <section id="sizes">

      <div class="container">

        <div class="section-head reveal">

          <div class="section-label">
            Made for every craving
          </div>

          <h2>
            Available in Three Sizes
          </h2>

          <p>
            From quick snacks to family-sized sharing.
          </p>

        </div>

        <div class="size-grid">

          <div class="size-card reveal">

            <div class="number">
              23g
            </div>

            <h3>
              Quick Crunch
            </h3>

            <p>
              Perfect for quick cravings, school snacks,
              sari-sari stores and trial packs.
            </p>

          </div>

          <div class="size-card reveal">

            <div class="number">
              90g
            </div>

            <h3>
              Everyday Favorite
            </h3>

            <p>
              Great for merienda, travel, sharing and everyday snacking.
            </p>

          </div>

          <div class="size-card reveal">

            <div class="number">
              550g
            </div>

            <h3>
              Big Sharing Pack
            </h3>

            <p>
              Made for families, parties, pasalubong,
              gatherings and bulk sharing.
            </p>

          </div>

        </div>

      </div>

    </section>

    <!-- COMPARISON -->

    <section class="comparison">

      <div class="container">

        <div class="section-head reveal">

          <div class="section-label">
            Find your crunch
          </div>

          <h2>
            Flavor & Crunch Guide
          </h2>

          <p>
            Not sure which pack is calling your name?
          </p>

        </div>

        <div class="table-wrap reveal">

          <table>

            <thead>

              <tr>
                <th>Flavor</th>
                <th>Pack Color</th>
                <th>Taste</th>
                <th>Spice Level</th>
                <th>Best For</th>
              </tr>

            </thead>

            <tbody>

              <tr>
                <td>Spicy</td>
                <td>Red</td>
                <td>Bold, savory, spicy</td>
                <td>Hot</td>
                <td>Bold cravings</td>
              </tr>

              <tr>
                <td>Garlic with Chips</td>
                <td>Green</td>
                <td>Garlicky, savory, crunchy</td>
                <td>Mild</td>
                <td>Sharing & merienda</td>
              </tr>

              <tr>
                <td>Classic Cheese</td>
                <td>Yellow</td>
                <td>Cheesy & savory</td>
                <td>Mild</td>
                <td>Family snacking</td>
              </tr>

            </tbody>

          </table>

        </div>

      </div>

    </section>

    <!-- NUTRITION -->

    <section
      class="nutrition"
      id="nutrition"
    >

      <div class="container">

        <div class="section-head reveal">

          <div class="section-label">
            Know your snack
          </div>

          <h2>
            Nutrition Facts
          </h2>

          <p>
            Select a flavor and size to view product information.
          </p>

        </div>

        <div class="nutrition-box reveal">

          <div class="selector">

            <label for="flavorSelect">
              Flavor
            </label>

            <select
              id="flavorSelect"
              onchange="updateNutrition()"
            >
              <option>Classic Cheese</option>
              <option>Spicy</option>
              <option>Garlic with Chips</option>
            </select>

            <label for="sizeSelect">
              Size
            </label>

            <select
              id="sizeSelect"
              onchange="updateNutrition()"
            >
              <option>23 g</option>
              <option>90 g</option>
              <option>550 g</option>
            </select>

            <p class="nutrition-note">
              Nutrition information is currently being prepared
              from the verified product labels.
              No placeholder nutritional numbers are presented as factual.
            </p>

          </div>

          <div class="nutrition-panel">

            <h3>
              Nutrition Facts
            </h3>

            <div class="nutrition-row">
